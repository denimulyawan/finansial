# ============================== LOGIN GOOGLE ==============================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=490916388090-t659uet42oph4cc70hgp40qhn2eeqsi3.apps.googleusercontent.com

# ======================= BACKEND DI VERCEL (CARA UTAMA) ==================
# Cara tercepat. Isi ketiganya, lalu aplikasi membaca Google Sheets langsung
# dari Vercel tanpa lewat Apps Script.
#
# SHEET_ID: lihat URL spreadsheet-mu
#   docs.google.com/spreadsheets/d/<BAGIAN_INI>/edit
SHEET_ID=

# GOOGLE_SERVICE_ACCOUNT_JSON: seluruh isi berkas JSON service account,
# atau versi base64-nya. Boleh satu baris panjang.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Dipakai hanya kalau sheet "Users" masih kosong, untuk mendaftarkan
# pengguna pertama. Boleh dikosongkan kalau sudah ada isinya.
OWNER_EMAIL=

# ============================ NOTIFIKASI TELEGRAM ========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== CADANGAN: GOOGLE APPS SCRIPT =======================
# Dipakai otomatis kalau SHEET_ID atau GOOGLE_SERVICE_ACCOUNT_JSON belum
# diisi, supaya aplikasi tetap jalan. Lebih lambat (5-8 detik per permintaan).
NEXT_PUBLIC_GAS_URL=
